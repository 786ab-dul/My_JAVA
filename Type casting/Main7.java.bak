class Tester1
{
	int x=10;
	void disp(){
		System.out.println("Hi");
	}
}
class Huliyacha extends Tester1
{
	void ho(){
		System.out.println("Hello");
	}
}


class Main8
{
	public static void main(String[] args) 
	{
		Tester1 t1 = new Huliyacha();
		t1.disp();
		System.out.println(t1.x);
		
		Huliyacha h1 = (Huliyacha)t1;
		h1.ho();
		
	}
}