class  Mob
{
	int cost;
	String model;
	String color;
	
	Mob(int cost, String color, String model){
		this.cost=cost;
		this.color=color;
		this.model=model;
		return;
	}
	public static void main(String[] args) 
	{
		MOb m1= new Mob(25000, "Black", "A13");
		System.out.println(m1.cost);
		System.out.println(m1.color);
		System.out.println(m1.model);
	}
}
